<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Planning {{ saison }} — {{ club }}</title>
<meta name="description" content="Créneaux d'entraînement et tir libre, saison {{ saison }}.">
<style>
:root {
  --bleu: #24406e;
  --bleu-fonce: #182c4e;
  --or: #a97e1c;
  --vert: #2f6b46;
  --encre: #1d2733;
  --gris: #5b6572;
  --fond: #eef1f5;
  --carte: #ffffff;
  --filet: #d4dae2;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--fond);
  color: var(--encre);
  font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
h1, h2, .heure {
  font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
}
nav { padding: 0.8rem 1.25rem 0; }
nav a { color: var(--bleu); font-weight: 600; }
header {
  background: var(--bleu);
  color: #fff;
  padding: 2rem 1.25rem 1.5rem;
  border-bottom: 4px solid var(--or);
}
.gabarit { max-width: 1240px; margin: 0 auto; }
header p { margin: 0; color: #c8d3e6; }
h1 { margin: 0.15rem 0 0.4rem; font-size: 1.9rem; font-weight: 600; letter-spacing: 0.01em; }
.legende {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem 1.4rem;
  padding: 0.85rem 1.25rem;
  font-size: 0.88rem;
  color: var(--gris);
}
.legende span { display: inline-flex; align-items: center; gap: 0.45rem; }
.pastille { width: 14px; height: 14px; border-radius: 2px; flex: none; }
.pastille.jeunes { background: var(--or); }
.pastille.adultes { background: var(--bleu); }
.pastille.tous { background: var(--vert); }
.pastille.libre { background: none; border: 2px dashed var(--vert); }
main { padding: 0 1.25rem 1.5rem; }
.semaine {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1rem;
  align-items: start;
}
.jour {
  background: var(--carte);
  border: 1px solid var(--filet);
  border-radius: 6px;
  padding: 1rem 1rem 1.1rem;
}
.jour h2 {
  margin: 0 0 0.75rem;
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--bleu-fonce);
  border-bottom: 1px solid var(--filet);
  padding-bottom: 0.45rem;
}
.creneau {
  border-left: 3px solid var(--gris);
  padding: 0.15rem 0 0.25rem 0.8rem;
  margin: 0 0 0.9rem;
}
.creneau.jeunes { border-color: var(--or); }
.creneau.adultes { border-color: var(--bleu); }
.creneau.tous { border-color: var(--vert); }
.heure { font-size: 1.02rem; color: var(--bleu-fonce); }
.creneau h3 { margin: 0.1rem 0 0.15rem; font-size: 1rem; font-weight: 600; }
.creneau p { margin: 0.1rem 0 0; font-size: 0.88rem; color: var(--gris); }
.libre {
  border: 2px dashed var(--vert);
  border-radius: 4px;
  padding: 0.5rem 0.75rem;
  font-size: 0.88rem;
  color: var(--vert);
}
.libre strong { font-weight: 600; }
footer {
  padding: 1.25rem;
  font-size: 0.88rem;
  color: var(--gris);
}
footer p { font-size: 1.2rem; font-weight: 600; margin: 0.2rem 0; }
a:focus-visible, :focus-visible { outline: 3px solid var(--or); outline-offset: 2px; }
@media print {
  body { background: #fff; font-size: 12px; }
  header { background: none; color: var(--encre); border-bottom-color: var(--encre); padding: 0 0 0.5rem; }
  header p { color: var(--gris); }
  .semaine { grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
  .jour { border-radius: 0; break-inside: avoid; }
}
</style>
</head>
<body>
<header>
  <div class="gabarit">
    <p>{{ club }}</p>
    <h1>Planning des créneaux — saison {{ saison }}</h1>
    <p>Salle d'armes et terrain, 1 rue Pierre de Coubertin, Pontoise</p>
  </div>
</header>
<nav class="gabarit"><a href="paysage.html">Version semaine, en grille paysage</a></nav>
<div class="legende gabarit" aria-hidden="true">
  <span><i class="pastille jeunes"></i>Jeunes</span>
  <span><i class="pastille adultes"></i>Adultes</span>
  <span><i class="pastille tous"></i>Tous publics</span>
  <span><i class="pastille libre"></i>Tir libre</span>
</div>
<main class="gabarit">
  <div class="semaine">
  {% for jour in jours %}
    <section class="jour" aria-labelledby="jour-{{ jour.nom }}">
      <h2 id="jour-{{ jour.nom }}">{{ jour.nom | capitalize }}</h2>
      {% for c in jour.creneaux %}
      <article class="creneau {{ c.public }}">
        <span class="heure">
          <time datetime="{{ c.debut }}">{{ c.debut | heure_fr }}</time>
          – <time datetime="{{ c.fin }}">{{ c.fin | heure_fr }}</time>
        </span>
        <h3>{{ c.intitule }}</h3>
        {% if c.get('detail') %}<p>{{ c['detail'] }}</p>{% endif %}
        {% if c.encadrants %}<p>{{ c.encadrants | join(', ') }}</p>{% endif %}
      </article>
      {% endfor %}
      {% if jour.tir_libre %}
      <p class="libre">
        <strong>Tir libre</strong><br />
      {{ jour.tir_libre }}
      </p>
      {% endif %}
    </section>
  {% endfor %}
  </div>
</main>
<footer class="gabarit">
  <p>{{ note_globale }}</p>
  <span>Mis à jour le {{ date_generation }} — <a href="https://arcpontoise.fr/">arcpontoise.fr</a></span>
</footer>
</body>
</html>
