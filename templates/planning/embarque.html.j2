<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Planning des créneaux — saison {{ saison }}</title>
<meta name="robots" content="noindex">
<style>
{% include "_palette.css" %}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: transparent;
  color: var(--encre);
  font: 15px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
h2 { font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; }
a { color: var(--accent); }
main { padding: 0.25rem; overflow-x: auto; }
.ouvrir { margin: 0.8rem 0 0.2rem; font-size: 0.85rem; }
{% include "planning/_grille.css" %}
</style>
</head>
<body>
<main>
{% include "planning/_grille.html.j2" %}
<p class="ouvrir">
  <a href="paysage.html" target="_blank" rel="noopener">Ouvrir le planning dans un nouvel onglet</a>
</p>
</main>
<script>
"use strict";

function publierHauteur() {
  window.parent.postMessage(
    {
      source: "arcpontoise-planning",
      hauteur: document.documentElement.scrollHeight,
    },
    "https://arcpontoise.fr"
  );
}

if (window.parent !== window) {
  window.addEventListener("load", publierHauteur);
  window.addEventListener("resize", publierHauteur);
}
</script>
</body>
</html>
