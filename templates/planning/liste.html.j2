{% extends "base.html.j2" %}
{% block titre %}Planning des créneaux — saison {{ saison }}{% endblock %}
{% block description %}Créneaux d'entraînement et tir libre, saison {{ saison }}.{% endblock %}
{% block sous_entete %}
<p class="adresse">Salle d'armes et terrain, 1 rue Pierre de Coubertin, Pontoise</p>
{% endblock %}
{% block styles %}
header .adresse { margin: 0.3rem 0 0; color: #ccd4ea; font-size: 0.92rem; }
.autre-vue { margin: 0 0 1rem; }
.autre-vue a { color: var(--accent); font-weight: 600; }
.legende {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem 1.4rem;
  margin: 0 0 1rem;
  font-size: 0.88rem;
  color: var(--gris);
}
.legende span { display: inline-flex; align-items: center; gap: 0.45rem; }
.pastille { width: 14px; height: 14px; border-radius: 2px; flex: none; }
.pastille.jeunes { background: var(--accent); }
.pastille.adultes { background: var(--bleu); }
.pastille.tous { background: var(--bleu-moyen); }
.pastille.libre { background: none; border: 2px dashed var(--accent); }
.semaine {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1rem;
  align-items: start;
}
.jour {
  background: var(--carte);
  border: 1px solid var(--filet);
  border-radius: 6px;
  padding: 1rem 1rem 1.1rem;
}
.jour h2 {
  margin: 0 0 0.75rem;
  font-size: 1.05rem;
  color: var(--bleu);
  border-bottom: 1px solid var(--filet);
  padding-bottom: 0.45rem;
}
.creneau {
  border-left: 3px solid var(--gris-doux);
  padding: 0.15rem 0 0.25rem 0.8rem;
  margin: 0 0 0.9rem;
}
.creneau.jeunes { border-color: var(--accent); }
.creneau.adultes { border-color: var(--bleu); }
.creneau.tous { border-color: var(--bleu-moyen); }
.heure { font-weight: 700; color: var(--bleu); }
.creneau h3 { margin: 0.1rem 0 0.15rem; font-size: 1rem; font-weight: 600; }
.creneau p { margin: 0.1rem 0 0; font-size: 0.88rem; color: var(--gris); }
.libre {
  border: 2px dashed var(--accent);
  border-radius: 4px;
  padding: 0.5rem 0.75rem;
  font-size: 0.88rem;
  color: var(--accent);
}
.libre strong { font-weight: 600; }
.note { font-size: 1.2rem; font-weight: 600; margin: 1.2rem 0 0.2rem; }
@media print {
  body { background: #fff; font-size: 12px; }
  header { background: none; color: var(--encre); border-bottom-color: var(--encre); padding: 0 0 0.5rem; }
  header .manuscrit, header .adresse { color: var(--gris); }
  nav.site, .autre-vue { display: none; }
  .semaine { grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
  .jour { border-radius: 0; break-inside: avoid; }
}
{% endblock %}
{% block contenu %}
<p class="autre-vue"><a href="paysage.html">Vue semaine, en grille paysage</a></p>
<div class="legende" aria-hidden="true">
  <span><i class="pastille jeunes"></i>Jeunes</span>
  <span><i class="pastille adultes"></i>Adultes</span>
  <span><i class="pastille tous"></i>Tous publics</span>
  <span><i class="pastille libre"></i>Tir libre</span>
</div>
<div class="semaine">
{% for jour in jours %}
  <section class="jour" aria-labelledby="jour-{{ jour.nom }}">
    <h2 id="jour-{{ jour.nom }}">{{ jour.nom | capitalize }}</h2>
    {% for c in jour.creneaux %}
    <article class="creneau {{ c.public }}">
      <span class="heure">
        <time datetime="{{ c.debut }}">{{ c.debut | heure_fr }}</time>
        – <time datetime="{{ c.fin }}">{{ c.fin | heure_fr }}</time>
      </span>
      <h3>{{ c.intitule }}</h3>
      {% if c.get('detail') %}<p>{{ c['detail'] }}</p>{% endif %}
      {% if c.encadrants %}<p>{{ c.encadrants | join(', ') }}</p>{% endif %}
    </article>
    {% endfor %}
    {% if jour.tir_libre %}
    <p class="libre">
      <strong>Tir libre</strong><br />
      {{ jour.tir_libre }}
    </p>
    {% endif %}
  </section>
{% endfor %}
</div>
<p class="note">{{ note_globale }}</p>
{% endblock %}
