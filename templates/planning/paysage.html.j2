{% extends "base.html.j2" %}
{% block titre %}Planning de la semaine — saison {{ saison }}{% endblock %}
{% block description %}Grille hebdomadaire des créneaux, saison {{ saison }}.{% endblock %}
{% block styles %}
:root { --hauteur-grille: 700px; }
main { overflow-x: auto; }
.autre-vue { margin: 0 0 1rem; }
.autre-vue a { color: var(--accent); font-weight: 600; }
.legende {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem 1.4rem;
  margin: 0 0 1rem;
  font-size: 0.85rem;
  color: var(--gris);
}
.legende span { display: inline-flex; align-items: center; gap: 0.45rem; }
.pastille { width: 13px; height: 13px; border-radius: 2px; flex: none; }
.pastille.jeunes { background: var(--accent); }
.pastille.adultes { background: var(--bleu); }
.pastille.tous { background: var(--bleu-moyen); }
.pastille.libre { background: none; border: 2px dashed var(--accent); }
.grille { min-width: 860px; }
.entetes, .corps, .rangee-libre {
  display: grid;
  grid-template-columns: 58px repeat(7, 1fr);
  column-gap: 6px;
}
.entetes h2 {
  margin: 0;
  padding: 0.5rem 0.3rem;
  font-size: clamp(0.78rem, 0.5vw + 0.42rem, 0.95rem);
  text-align: center;
  color: var(--bleu);
  background: var(--carte);
  border: 1px solid var(--filet);
  border-bottom: none;
  border-radius: 6px 6px 0 0;
}
.axe { position: relative; }
.heure-axe {
  position: absolute;
  right: 8px;
  transform: translateY(-55%);
  font-size: clamp(0.7rem, 0.35vw + 0.45rem, 0.82rem);
  color: var(--gris);
}
.colonne {
  position: relative;
  height: var(--hauteur-grille);
  background:
    repeating-linear-gradient(
      to bottom,
      var(--filet) 0 1px,
      transparent 1px calc(100% / {{ nb_heures }})
    )
    var(--carte);
  border: 1px solid var(--filet);
  border-top: none;
}
.bloc {
  position: absolute;
  overflow: hidden;
  padding: 4px 6px;
  border-radius: 3px;
  border-left: 3px solid;
  color: #fff;
  font-size: clamp(0.62rem, 0.55vw + 0.33rem, 0.78rem);
  line-height: 1.3;
  overflow-wrap: break-word;
  hyphens: auto;
}
.bloc time { white-space: nowrap; }
.bloc.compact {
  padding: 3px 4px;
  border-left-width: 2px;
  font-size: clamp(0.54rem, 0.48vw + 0.28rem, 0.66rem);
  line-height: 1.22;
}
.bloc.compact h3 { margin: 1px 0; }
.bloc.jeunes { background: var(--accent); border-color: var(--bleu); }
.bloc.adultes { background: var(--bleu); border-color: var(--bleu-fonce); }
.bloc.tous { background: var(--bleu-moyen); border-color: var(--bleu-fonce); }
.bloc h3 {
  margin: 1px 0 2px;
  font-size: 1.02em;
  font-weight: 600;
  text-transform: none;
  letter-spacing: 0;
}
.bloc p { margin: 0; opacity: 0.88; font-size: 0.92em; }
.rangee-libre { margin-top: 6px; }
.libre {
  border: 2px dashed var(--accent);
  border-radius: 4px;
  padding: 0.35rem 0.5rem;
  font-size: clamp(0.66rem, 0.4vw + 0.4rem, 0.76rem);
  color: var(--accent);
}
.note { font-size: 1.2rem; font-weight: 600; margin: 1.2rem 0 0.2rem; }
@media print {
  @page { size: A4 landscape; margin: 8mm; }
  :root { --hauteur-grille: 128mm; }
  body { background: #fff; font-size: 11px; }
  header { background: none; color: var(--encre); border-bottom-color: var(--encre); padding: 0 0 0.4rem; }
  header .manuscrit { color: var(--gris); }
  nav.site, .autre-vue { display: none; }
  main { overflow: visible; padding: 0; }
  .grille { min-width: 0; }
  .bloc, .colonne { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
}
{% endblock %}
{% block contenu %}
<p class="autre-vue"><a href="./">Vue liste, adaptée au téléphone</a></p>
<div class="legende" aria-hidden="true">
  <span><i class="pastille jeunes"></i>Jeunes</span>
  <span><i class="pastille adultes"></i>Adultes</span>
  <span><i class="pastille tous"></i>Tous publics</span>
  <span><i class="pastille libre"></i>Tir libre</span>
</div>
<div class="grille">
  <div class="entetes">
    <span></span>
    {% for jour in jours_complets %}
    <h2>{{ jour.nom | capitalize }}</h2>
    {% endfor %}
  </div>
  <div class="corps">
    <div class="axe">
      {% for h in heures %}
      <span class="heure-axe" style="top: {{ h.haut }}%">{{ h.label }}</span>
      {% endfor %}
    </div>
    {% for jour in jours_complets %}
    <div class="colonne">
      {% for b in jour.blocs %}
      <article
        class="bloc {{ b.public }}{% if b.compact %} compact{% endif %}"
        style="top: {{ b.haut }}%; height: {{ b.hauteur }}%; left: {{ b.gauche }}%; width: {{ b.largeur }}%;"
        title="{{ b.debut | heure_fr }} – {{ b.fin | heure_fr }} : {{ b.intitule }}{% if b.get('detail') %} ({{ b['detail'] }}){% endif %}{% if b.encadrants %} — {{ b.encadrants | join(', ') }}{% endif %}">
        <time datetime="{{ b.debut }}">{{ b.debut | heure_fr }}</time>
        – <time datetime="{{ b.fin }}">{{ b.fin | heure_fr }}</time>
        <h3>{{ b.intitule }}</h3>
        {% if b.get('detail') %}<p>{{ b['detail'] }}</p>{% endif %}
        {% if b.encadrants %}<p>{{ b.encadrants | join(', ') }}</p>{% endif %}
      </article>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  <div class="rangee-libre">
    <span></span>
    {% for jour in jours_complets %}
    <p class="libre">
      {% if jour.tir_libre %}<strong>Tir libre</strong><br />
      {{ jour.tir_libre }}{% endif %}
    </p>
    {% endfor %}
  </div>
</div>
<p class="note">{{ note_globale }}</p>
{% endblock %}
