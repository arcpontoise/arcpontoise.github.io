<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block titre %}{% endblock %} — {{ club }}</title>
<meta name="description" content="{% block description %}{% endblock %}">
{% if logo_existe %}<link rel="icon" href="{{ prefixe }}static/img/logo.jpg">{% endif %}
<style>
/* Charte graphique du club (palette des publications Instagram) */
@font-face {
  font-family: "Caveat";
  src: url("{{ prefixe }}static/fonts/caveat.woff2") format("woff2");
  font-weight: 400 700;
  font-display: swap;
}
{% include "_palette.css" %}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--fond);
  color: var(--encre);
  font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
h1, h2 {
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.manuscrit {
  font-family: "Caveat", "Segoe Script", "Bradley Hand", cursive;
  text-transform: none;
  letter-spacing: 0;
}
.entete-flex { display: flex; align-items: center; gap: 1rem; }
.logo { height: 64px; width: auto; border-radius: 4px; flex: none; }
header {
  background: var(--bleu);
  color: var(--fond);
  padding: 1.4rem 1.25rem 1.1rem;
  border-bottom: 4px solid var(--accent);
}
.gabarit { max-width: 1240px; margin: 0 auto; }
header .manuscrit { margin: 0; font-size: 1.55rem; line-height: 1.1; color: #ccd4ea; }
h1 { margin: 0.15rem 0 0; font-size: 1.55rem; }
nav.site {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem 1.4rem;
  padding: 0.8rem 1.25rem 0;
}
nav.site a { color: var(--accent); font-weight: 600; }
nav.site a[aria-current] { color: var(--encre); text-decoration: none; }
main { padding: 1.25rem 1.25rem 1.5rem; }
footer { padding: 0 1.25rem 1.5rem; font-size: 0.88rem; color: var(--gris); }
a:focus-visible, :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
{% block styles %}{% endblock %}
</style>
</head>
<body>
<header>
  <div class="gabarit entete-flex">
    {% if logo_existe %}<img class="logo" src="{{ prefixe }}static/img/logo.jpg" alt="">{% endif %}
    <div>
    <p class="manuscrit">{{ club }}</p>
    <h1>{% block entete %}{{ self.titre() }}{% endblock %}</h1>
    {% block sous_entete %}{% endblock %}
    </div>
  </div>
</header>
<nav class="site gabarit">
  <a href="{{ prefixe }}."{% if page == 'accueil' %} aria-current="page"{% endif %}>Accueil</a>
  <a href="{{ prefixe }}planning/"{% if page == 'planning' %} aria-current="page"{% endif %}>Planning</a>
  <a href="{{ prefixe }}tarifs/"{% if page == 'tarifs' %} aria-current="page"{% endif %}>Tarifs</a>
  <a href="{{ prefixe }}calculateur/"{% if page == 'calculateur' %} aria-current="page"{% endif %}>Calculateur</a>
</nav>
<main class="gabarit">
{% block contenu %}{% endblock %}
</main>
<footer class="gabarit">
  <p>Mis à jour le {{ date_generation }} — <a href="https://arcpontoise.fr/">arcpontoise.fr</a></p>
</footer>
</body>
</html>
