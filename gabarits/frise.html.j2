{% extends "page.html.j2" %}
{#
  Timeline page: the Markdown text, with its « ## » periods and « ### » dated
  steps drawn as a vertical timeline (static/css/vitrine.css, .frise).
#}
{% block contenu %}
{% if fil %}
<p class="fil"><a href="/">Accueil</a>{% for lien, titre in fil %} › <a href="{{ lien }}">{{ titre }}</a>{% endfor %}</p>
{% endif %}
<h1>{{ page.titre }}</h1>
<div class="texte frise">
{{ contenu }}
</div>
{% endblock %}
