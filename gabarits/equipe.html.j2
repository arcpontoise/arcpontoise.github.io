{% extends "page.html.j2" %}
{#
  The coaches: a card each, with the portrait read live from the unlisted
  « encadrants » gallery of drop (photo description = name, see
  js/arc-galerie.js, <arc-portraits>) and initials until it is there.
  The presentation unfolds on click, without JavaScript (<details>).
#}
{% block largeur %}{% endblock %}
{% block scripts %}
<script src="/js/arc-galerie.js" defer></script>
{% endblock %}
{% block apres %}
<arc-portraits class="equipe" source="{{ galeries }}" galerie="encadrants">
{% for membre in equipe %}
  <details class="encadrant" id="{{ membre.ancre }}"{% if not membre.points %} data-vide=""{% endif %}>
    <summary class="encadrant-tete">
      <span class="portrait" data-nom="{{ membre.nom }}" aria-hidden="true">{{ membre.initiales }}</span>
      <span class="encadrant-nom">{{ membre.nom }}</span>
    </summary>
    {% if membre.points %}
    <ul>
      {% for point in membre.points %}
      <li>{{ point }}</li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="discret">Encadrant diplômé de la Fédération française de tir à l'arc.</p>
    {% endif %}
  </details>
{% endfor %}
</arc-portraits>
{% endblock %}
